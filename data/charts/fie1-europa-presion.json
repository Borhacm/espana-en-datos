 "title": {
  "es": "España recauda en impuestos y cotizaciones el 38,1 % del PIB: 13 de los 27 países de la UE recaudan más",
  "en": "Spain collects 38.1% of GDP in taxes and social contributions: 13 of the 27 EU countries collect more"
 },
 "subtitle": {
  "es": "Impuestos y cotizaciones sociales, 2025, en % del PIB. Media de la UE: 40,7 %",
  "en": "Taxes and social contributions, 2025, as % of GDP. EU average: 40.7%"
 },
 "unit": {
  "es": "% del PIB",
  "en": "% of GDP"
 },
 "source": {
  "name": "Eurostat, cuentas de las administraciones públicas",
  "license": "CC BY 4.0",
  "dataset": "gov_10a_taxag",
