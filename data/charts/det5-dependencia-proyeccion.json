 "title": {
  "es": "El INE proyecta 51,8 mayores de 64 por cada 100 personas de 16 a 64 años en 2050; sin migración, serían 69,9",
  "en": "INE projects 51.8 people over 64 for every 100 people aged 16 to 64 in 2050; without migration, there would be 69.9"
 },
 "subtitle": {
  "es": "Tasa de dependencia de los mayores de 64: observada, 1975-2025, y proyectada, 2026-2075, en dos escenarios del INE",
  "en": "Old-age dependency ratio: observed, 1975-2025, and projected, 2026-2075, in two INE scenarios"
 },
 "unit": {
  "es": "Mayores de 64 por cada 100 personas de 16 a 64",
  "en": "People over 64 per 100 people aged 16 to 64"
 },
