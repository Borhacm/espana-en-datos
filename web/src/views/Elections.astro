---
// Especial elecciones generales del 29N: encuestas, mapa de 2023, quién gobierna y notas con este gancho.
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import LinkList from "../components/LinkList.astro";
import SeatSimulator from "../components/SeatSimulator.astro";
import { localizeHref, notesOf, published, themeById } from "../lib/themes";
import { sourceName } from "../lib/content-types";
import { formatDate, notePath, paths, themePath, type Lang } from "../lib/i18n";
import "../styles/charts.css";

interface Props { lang: Lang }
const { lang } = Astro.props;

const theme = themeById("elecciones")!;
const lenses = theme.lenses!;
// Notas del especial y análisis del Congreso
const notes = [...notesOf("elecciones"), ...notesOf("congreso")];
// Piezas de campaña: los temas publicados (con el gancho electoral) y las notas del especial, de la más reciente a la más antigua
const pieces = [
  ...published().filter((t) => !t.hub).map((t) => ({ href: themePath(t.slug)[lang], title: t.title[lang], dek: t.dek?.[lang], date: t.published! })),
  ...notes.map((n) => ({ href: notePath(n.slug)[lang], title: n.title[lang], dek: n.dek[lang], date: n.published })),
].sort((a, b) => b.date.localeCompare(a.date));

const copy = {
  es: {
    kicker: "Especial",
    h1: "Elecciones generales del 29 de noviembre",
    calendar: "Calendario electoral",
    // Calendario electoral (LOREG): convocatoria en el BOE el 6 de octubre, votación 54 días después
    dates: [
      { date: "6 de octubre", text: "El BOE publica la convocatoria." },
      { date: "13 de noviembre", text: "Empieza la campaña electoral." },
      { date: "24 al 28 de noviembre", text: "Prohibido publicar encuestas (veda). Aquí se oculta el seguimiento." },
      { date: "28 de noviembre", text: "Jornada de reflexión." },
      { date: "29 de noviembre", text: "Votación, de 9.00 a 20.00 (una hora menos en Canarias)." },
    ],
    polls: "Encuestas",
    start: "El punto de partida",
    congressH: "La legislatura en el Congreso",
    congressLede: "Cómo han votado los partidos desde 2023: quién coincide con quién y qué decretos cayeron.",
    congressTitle: "El Congreso en datos",
    pieces: "Análisis de campaña",
    howH: "Cómo cubrimos estas elecciones",
    principles: [
      "Todos los partidos se tratan igual: mismo formato, mismas fuentes y mismo nivel de exigencia.",
      "Contamos lo que dicen los datos, no a quién votar. Cuando la evidencia no es concluyente, lo decimos.",
      "Cada cifra enlaza a su fuente original y se puede descargar.",
      "Las encuestas se muestran todas, pero en la media solo entran las que tienen muestreo probabilístico. El método está publicado.",
    ],
    independent: "España en datos es un proyecto independiente. No trabaja para ningún partido ni empresa demoscópica.",
    method: "Metodología completa",
    sources: "Fuentes del texto",
    countdown: { days: "Faltan {n} días.", tomorrow: "Mañana se vota.", today: "Hoy se vota." },
  },
  en: {
    kicker: "Special",
    h1: "Spain's general election on 29 November",
    calendar: "Election calendar",
    dates: [
      { date: "6 October", text: "The official gazette (BOE) publishes the call for the election." },
      { date: "13 November", text: "The campaign begins." },
      { date: "24 to 28 November", text: "Publishing polls is banned. The poll tracker is hidden here." },
      { date: "28 November", text: "Day of reflection: no campaigning." },
      { date: "29 November", text: "Voting, from 9 am to 8 pm (an hour earlier in the Canary Islands)." },
    ],
    polls: "Polls",
    start: "The starting point",
    congressH: "The parliament in Congress",
    congressLede: "How the parties have voted since 2023: who votes with whom and which decrees fell.",
    congressTitle: "Congress in data",
    pieces: "Campaign analysis",
    howH: "How we cover this election",
    principles: [
      "Every party is treated the same: same format, same sources and same standards.",
      "We report what the data says, not who to vote for. When the evidence is inconclusive, we say so.",
      "Every figure links to its original source and can be downloaded.",
      "All polls are shown, but only those with probability sampling enter the average. The method is published.",
    ],
    independent: "Spain in data is an independent project. It does not work for any party or polling company.",
    method: "Full methodology",
    sources: "Sources for the text",
    countdown: { days: "{n} days to go.", tomorrow: "Spain votes tomorrow.", today: "Spain votes today." },
  },
}[lang];
---
<Base lang={lang} path={paths.elections} section="elections" title={theme.title[lang]} description={theme.dek![lang]}>
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">{copy.kicker}</p>
        <h1>{copy.h1}</h1>
        <p class="dek">{theme.dek![lang]}</p>
        <p class="countdown" data-countdown data-days={copy.countdown.days} data-tomorrow={copy.countdown.tomorrow} data-today={copy.countdown.today} hidden></p>
      </div>
      <ol class="calendar" aria-label={copy.calendar}>
        {copy.dates.map((d) => <li><span class="c-date">{d.date}</span><span class="c-text">{d.text}</span></li>)}
      </ol>
    </div>
  </header>

  <section class="wrap part" id="encuestas" aria-labelledby="enc-h">
    <h2 id="enc-h">{copy.polls}</h2>
    <p class="lede">{lenses.tiempo.lede[lang]}</p>
    <Blocks lang={lang} blocks={lenses.tiempo.body} codePrefix={theme.code} />
    <SeatSimulator lang={lang} />
  </section>

  <section class="wrap part" id="territorio" aria-labelledby="ter-h">
    <h2 id="ter-h">{copy.start}</h2>
    <p class="lede">{lenses.dentro.lede[lang]}</p>
    <Blocks lang={lang} blocks={lenses.dentro.body} codePrefix={theme.code} />
  </section>

  <section class="wrap part" aria-labelledby="cg-h">
    <h2 id="cg-h">{copy.congressH}</h2>
    <p class="lede">{copy.congressLede}</p>
    <LinkList items={[{ href: paths.congress[lang], title: copy.congressTitle, dek: themeById("congreso")?.dek?.[lang] }]} />
  </section>

  {pieces.length > 0 && (
    <section class="wrap part" id="piezas" aria-labelledby="notes-h">
      <h2 id="notes-h">{copy.pieces}</h2>
      <LinkList items={pieces.map((x) => ({ href: x.href, title: x.title, dek: x.dek, meta: formatDate(x.date, lang) }))} />
    </section>
  )}

  <section class="wrap part principles" aria-labelledby="how-h">
    <h2 id="how-h">{copy.howH}</h2>
    <ul class="prose">{copy.principles.map((t) => <li>{t}</li>)}</ul>
    <p class="prose">
      {copy.independent}
      {" "}<a href={paths.method[lang]}>{copy.method}</a>.
    </p>
    {theme.sources && (
      <p class="src">{copy.sources}: {theme.sources.map((s, i) => <>{i > 0 && ", "}<a href={localizeHref(s.url, lang)} rel="noopener">{sourceName(s, lang)}</a></>)}.</p>
    )}
  </section>

  <script>
    import "../scripts/main.ts";
    // Cuenta atrás hasta la votación (hora peninsular)
    const el = document.querySelector<HTMLElement>("[data-countdown]");
    if (el) {
      const days = Math.ceil((+new Date("2026-11-29T09:00:00+01:00") - Date.now()) / 864e5);
      if (days > 1) el.textContent = el.dataset.days!.replace("{n}", String(days));
      else if (days === 1) el.textContent = el.dataset.tomorrow!;
      else if (days === 0) el.textContent = el.dataset.today!;
      el.hidden = days < 0;
    }
  </script>
</Base>

<style>
  .hero { background: #151826; color: #f5f6f8; padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .kicker { margin: 0 0 0.75rem; font-weight: 600; font-size: 0.9rem; color: #a89ef7; text-transform: uppercase; letter-spacing: 0.08em; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1; max-width: 16ch; }
  .dek { margin-top: 1.25rem; max-width: 34rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: #c9cdd8; }
  .countdown { margin: 1rem 0 0; font-weight: 700; font-size: 1.1rem; color: #f5f6f8; }
  .calendar { list-style: none; margin: 0; padding: 0; border-top: 1px solid #3a3f55; }
  .calendar li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1rem; padding-block: 0.6rem; border-bottom: 1px solid #3a3f55; font-size: 0.95rem; }
  .c-date { font-weight: 700; }
  .c-text { color: #c9cdd8; }

  .part { padding-top: clamp(3rem, 6vw, 5rem); }
  .part h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .lede { margin-top: 0.75rem; max-width: 36rem; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.4; font-weight: 500; }
  .principles ul { padding-left: 1.2rem; margin-top: 1.25rem; }
  .principles li { margin-bottom: 0.6rem; }
  .src { font-size: 0.9rem; color: var(--ink-3); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .calendar li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
