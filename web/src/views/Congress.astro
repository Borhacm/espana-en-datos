---
// El Congreso en datos: votaciones nominales de la XV legislatura (coincidencias, lado ganador, decretos derogados).
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import CongressExplorer from "../components/CongressExplorer.astro";
import { localizeHref, notesOf, themeById } from "../lib/themes";
import LinkList from "../components/LinkList.astro";
import { loadBase } from "../lib/data";
import { formatDate, formatNumber, notePath, paths, type Lang } from "../lib/i18n";
import { sourceName } from "../lib/content-types";
import "../styles/charts.css";

interface Props { lang: Lang }
const { lang } = Astro.props;
const theme = themeById("congreso")!;
const body = theme.lenses!.tiempo;
const base = loadBase("congreso-xv");
const analyses = notesOf("congreso");
const first = base.rows[0].date;
const last = base.rows[base.rows.length - 1].date;
const copy = {
  es: {
    kicker: "XV legislatura",
    stats: ["votaciones nominales en el Pleno", "decretos-ley del Gobierno derogados", "de votaciones en las que PP y PSOE votaron lo mismo"],
    period: (a: string, b: string) => `Votaciones del ${a} al ${b}. Las del 1 y 2 de octubre de 2026 aún no están en los datos abiertos.`,
    analysis: "Análisis",
    howH: "Cómo está hecho",
    how: [
      "Usamos todas las votaciones nominales del Pleno publicadas por el Congreso. No incluimos las que se aprueban por asentimiento.",
      "El voto de un partido es la opción que eligió la mayoría de sus diputados presentes. El Grupo Mixto se separa por partido.",
      "El resultado de cada votación se calcula por mayoría simple. Los empates que se repitieron fuera de los datos abiertos se corrigen con fuentes oficiales.",
    ],
    download: "Los datos se pueden descargar desde cada gráfico.",
    method: "Metodología completa",
    sources: "Fuentes",
    back: "Volver al especial de las elecciones del 29N",
  },
  en: {
    kicker: "15th parliament",
    stats: ["roll-call votes in the plenary", "government decree-laws struck down", "of votes in which PP and PSOE voted the same way"],
    period: (a: string, b: string) => `Votes from ${a} to ${b}. Those of 1 and 2 October 2026 are not yet in the open data.`,
    analysis: "Analysis",
    howH: "How it is made",
    how: [
      "We use every roll-call vote in the plenary published by Congress. Motions passed by unanimous assent are not included.",
      "A party's vote is the option chosen by the majority of its deputies present. The Mixed Group is split by party.",
      "The outcome of each vote is calculated by simple majority. Ties that were repeated outside the open data are corrected with official sources.",
    ],
    download: "The data can be downloaded from each chart.",
    method: "Full methodology",
    sources: "Sources",
    back: "Back to the 29 November election special",
  },
}[lang];
const STATS = [
  { value: formatNumber(base.rows.length, lang, 0), label: copy.stats[0] },
  { value: "13", label: copy.stats[1] },
  { value: lang === "es" ? "39 %" : "39%", label: copy.stats[2] },
];
---
<Base lang={lang} path={paths.congress} section="congress" title={theme.title[lang]} description={theme.dek![lang]}>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">{copy.kicker}</p>
      <h1>{theme.title[lang]}</h1>
      <p class="dek">{theme.dek![lang]}</p>
      <ul class="stats">
        {STATS.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
      <p class="period">{copy.period(formatDate(first, lang), formatDate(last, lang))}</p>
    </div>
  </header>

  {analyses.length > 0 && (
    <section class="wrap part">
      <LinkList items={analyses.map((n) => ({ href: notePath(n.slug)[lang], title: n.title[lang], dek: n.dek[lang], meta: `${copy.analysis}. ${formatDate(n.published, lang)}.` }))} />
    </section>
  )}

  <section class="wrap part">
    <p class="lede">{body.lede[lang]}</p>
    <Blocks lang={lang} blocks={body.body} codePrefix={theme.code} />
    <CongressExplorer lang={lang} />
  </section>

  <section class="wrap part principles">
    <h2>{copy.howH}</h2>
    <ul class="prose">
      {copy.how.map((i) => <li>{i}</li>)}
      <li>{copy.download} <a href={paths.method[lang]}>{copy.method}</a>.</li>
    </ul>
    {theme.sources && (
      <p class="src">{copy.sources}: {theme.sources.map((s, i) => <>{i > 0 && ", "}<a href={localizeHref(s.url, lang)} rel="noopener">{sourceName(s, lang)}</a></>)}.</p>
    )}
    <p class="prose"><a href={paths.elections[lang]}>{copy.back}</a></p>
  </section>

  <script>
    import "../scripts/main.ts";
  </script>
</Base>

<style>
  .hero { background: #151826; color: #f5f6f8; padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .kicker { margin: 0 0 0.75rem; font-weight: 600; font-size: 0.9rem; color: #a89ef7; text-transform: uppercase; letter-spacing: 0.08em; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1; }
  .dek { margin-top: 1.25rem; max-width: 40rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: #c9cdd8; }
  .stats { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; border-top: 1px solid #3a3f55; padding-top: 1.25rem; }
  .stats strong { display: block; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; }
  .stats span { display: block; margin-top: 0.4rem; color: #c9cdd8; font-size: 0.95rem; }
  .period { margin: 1.25rem 0 0; color: #9aa0b2; font-size: 0.88rem; }
  .part { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .lede { max-width: 36rem; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.4; font-weight: 500; }
  .principles h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .principles ul { padding-left: 1.2rem; margin-top: 1.25rem; }
  .principles li { margin-bottom: 0.6rem; }
  .src { font-size: 0.9rem; color: var(--ink-3); }
  @media (max-width: 700px) { .stats { grid-template-columns: 1fr; } }
</style>
