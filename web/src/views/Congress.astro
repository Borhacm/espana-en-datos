---
// El Congreso en datos: votaciones nominales de la XV legislatura (coincidencias, lado ganador, decretos derogados).
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import CongressExplorer from "../components/CongressExplorer.astro";
import { themeById } from "../lib/themes";
import { loadBase } from "../lib/data";
import { formatDate, paths } from "../lib/i18n";
import "../styles/charts.css";

const theme = themeById("congreso")!;
const body = theme.lenses!.tiempo;
const base = loadBase("congreso-xv");
const first = base.rows[0].date;
const last = base.rows[base.rows.length - 1].date;
const STATS = [
  { value: base.rows.length.toLocaleString("es-ES"), label: "votaciones nominales en el Pleno" },
  { value: "13", label: "decretos-ley del Gobierno derogados" },
  { value: "39 %", label: "de votaciones en las que PP y PSOE votaron lo mismo" },
];
---
<Base lang="es" path={paths.congress} section="congress" title={theme.title.es} description={theme.dek!.es}>
  <header class="hero">
    <div class="wrap">
      <p class="kicker">XV legislatura</p>
      <h1>{theme.title.es}</h1>
      <p class="dek">{theme.dek!.es}</p>
      <ul class="stats">
        {STATS.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
      <p class="period">Votaciones del {formatDate(first)} al {formatDate(last)}. Las del 1 y 2 de octubre de 2026 aún no están en los datos abiertos.</p>
    </div>
  </header>

  <section class="wrap part">
    <p class="lede">{body.lede.es}</p>
    <Blocks lang="es" blocks={body.body} codePrefix={theme.code} />
    <CongressExplorer />
  </section>

  <section class="wrap part principles">
    <h2>Cómo está hecho</h2>
    <ul class="prose">
      <li>Usamos todas las votaciones nominales del Pleno publicadas por el Congreso. No incluimos las que se aprueban por asentimiento.</li>
      <li>El voto de un partido es la opción que eligió la mayoría de sus diputados presentes. El Grupo Mixto se separa por partido.</li>
      <li>El resultado de cada votación se calcula por mayoría simple. Los empates que se repitieron fuera de los datos abiertos se corrigen con fuentes oficiales.</li>
      <li>Los datos se pueden descargar desde cada gráfico. <a href={paths.method.es}>Metodología completa</a>.</li>
    </ul>
    {theme.sources && (
      <p class="src">Fuentes: {theme.sources.map((s, i) => <>{i > 0 && ", "}<a href={s.url} rel="noopener">{s.name}</a></>)}.</p>
    )}
    <p class="prose"><a href={paths.elections.es}>Volver al especial de las elecciones del 29N</a></p>
  </section>

  <script>
    import "../scripts/main.ts";
  </script>
</Base>

<style>
  .hero { background: #151826; color: #f5f6f8; padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .kicker { margin: 0 0 0.75rem; font-weight: 600; font-size: 0.9rem; color: #a89ef7; text-transform: uppercase; letter-spacing: 0.08em; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1; }
  .dek { margin-top: 1.25rem; max-width: 40rem; font-size: clamp(1.1rem, 1.6vw, 1.3rem); color: #c9cdd8; }
  .stats { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; border-top: 1px solid #3a3f55; padding-top: 1.25rem; }
  .stats strong { display: block; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; }
  .stats span { display: block; margin-top: 0.4rem; color: #c9cdd8; font-size: 0.95rem; }
  .period { margin: 1.25rem 0 0; color: #9aa0b2; font-size: 0.88rem; }
  .part { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .lede { max-width: 36rem; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.4; font-weight: 500; }
  .principles h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .principles ul { padding-left: 1.2rem; margin-top: 1.25rem; }
  .principles li { margin-bottom: 0.6rem; }
  .src { font-size: 0.9rem; color: var(--ink-3); }
  @media (max-width: 700px) { .stats { grid-template-columns: 1fr; } }
</style>
