---
// 17 puntos, uno por comunidad autónoma, en una rejilla de 6 x 3 a la que le falta el último.
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
const dots = Array.from({ length: 17 }, (_, i) => ({ x: (i % 6) * 4 + 2, y: Math.floor(i / 6) * 4 + 2 }));
---
<svg class={cls} width={size} height={(size * 12) / 24} viewBox="0 0 24 12" aria-hidden="true">
  {dots.map((d) => <circle cx={d.x} cy={d.y} r="1.35" fill="currentColor" />)}
</svg>
