---
// Simulador de escaños: el lector elige el voto nacional de cada partido y ve el reparto de diputados.
// El modelo está en scripts/simulator-model.ts y se comprueba con `npm run check:sim`.
import { loadBase } from "../lib/data";
import { formatDate } from "../lib/i18n";
import { inVedaAt } from "../lib/veda";

const data = loadBase("simulador");
// Veda electoral: si se compila durante la veda, el simulador no lleva la media de encuestas; parte de 2023
const veda = inVedaAt();
if (veda) { data.defaults = Object.fromEntries(data.parties.map((p: string) => [p, data.national_2023[p] ?? 0])); data.defaults_date = null; }
const seatsData = loadBase("escanos-2026");
const parties: string[] = data.parties;
const changed = seatsData.rows.filter((r: any) => {
  const p = data.provinces.find((x: any) => x.geo === r.geo);
  return p && p.seats !== p.seats_2023;
}).map((r: any) => {
  const p = data.provinces.find((x: any) => x.geo === r.geo);
  return `${r.name} (${p.seats_2023} a ${p.seats})`;
});
---
<section class="sim" id="simulador" aria-labelledby="sim-h" data-sim>
  <p class="code">EL-SIM</p>
  <h3 id="sim-h">Simulador de escaños</h3>
  <p class="sub">
    Mueve el voto de cada partido y mira cuántos diputados saldrían.{" "}
    {veda ? <span>Empieza con el resultado de 2023.</span> : <span data-poll-ref>Empieza con la media de encuestas del {formatDate(data.defaults_date)}.</span>}
  </p>

  <div class="sim-grid">
    <form class="inputs" aria-label="Voto nacional de cada partido" onsubmit="return false">
      {parties.map((p) => (
        <label class="row" style={`--c: var(--p-${p.toLowerCase()})`}>
          <span class="name"><i></i>{p}</span>
          <input type="range" min="0" max="45" step="0.1" name={p} value={data.defaults[p] ?? 0} aria-describedby="sim-note" />
          <output class="pct" for={p}></output>
        </label>
      ))}
      <p class="fixed">ERC, Junts, EH Bildu, PNV, BNG, CC y UPN mantienen su voto de 2023 en sus provincias.</p>
      <div class="buttons">
        {!veda && <button type="button" data-preset="defaults" data-poll-ref>Media de encuestas</button>}
        <button type="button" data-preset="2023">Resultado de 2023</button>
      </div>
    </form>

    <div class="results" aria-live="polite">
      <div class="bar-wrap">
        <div class="bar" data-bar></div>
        <div class="majority" title="Mayoría absoluta: 176"><span>176</span></div>
      </div>
      <table class="seats">
        <thead><tr><th scope="col">Partido</th><th scope="col">Escaños</th><th scope="col">Cambio sobre 2023</th></tr></thead>
        <tbody data-table></tbody>
      </table>
      <h4>Sumas posibles</h4>
      <p class="combos-note">Solo aritmética: no indica que esos pactos vayan a producirse.</p>
      <ul class="combos" data-combos></ul>
    </div>
  </div>

  <footer class="sim-foot" id="sim-note">
    <p>
      <strong>No es una predicción.</strong> Cada partido sube o baja en la misma proporción en todas las provincias respecto a 2023
      (Podemos, con la distribución que tuvo Sumar, con quien se presentó; SALF, igual en todas). Después se reparten los escaños de cada
      provincia con la ley D'Hondt y el umbral del 3 %. Los resultados reales dependen de cómo se reparte el voto en cada provincia.
    </p>
    <p>
      Escaños de 2026 por provincia calculados con la población oficial a 1 de enero de {seatsData.population_year} (LOREG, art. 162)
      {changed.length > 0 && <>: cambian {changed.join(" y ")}</>}.
      {!seatsData.verified && " Pendiente de contrastar con el decreto de convocatoria."}
      {" "}Fuentes: <a href="https://infoelectoral.interior.gob.es/opencms/es/elecciones-celebradas/area-de-descargas/" rel="noopener">Ministerio del Interior</a>,
      {" "}<a href={seatsData.source.url} rel="noopener">INE</a>.
    </p>
  </footer>

  <script type="application/json" data-sim-data set:html={JSON.stringify(data)}></script>
</section>

<script>
  import { simulate, type SimData } from "../scripts/simulator-model";
  import { inVeda } from "../scripts/charts/polls";

  const root = document.querySelector<HTMLElement>("[data-sim]");
  if (root) {
    const data: SimData & { defaults: Record<string, number> } = JSON.parse(root.querySelector("[data-sim-data]")!.textContent!);
    const inputs = [...root.querySelectorAll<HTMLInputElement>("input[type=range]")];
    const base2023 = simulate(Object.fromEntries(data.parties.map((p) => [p, data.national_2023[p] ?? 0])), data, "seats_2023").total;
    const fmt = new Intl.NumberFormat("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    const VAR: Record<string, string> = {
      PP: "--p-pp", PSOE: "--p-psoe", Vox: "--p-vox", Sumar: "--p-sumar", Podemos: "--p-podemos", SALF: "--p-salf",
      PNV: "--p-pnv", "EH Bildu": "--p-bildu", UPN: "--p-upn", Junts: "--p-junts", ERC: "--p-erc", BNG: "--p-bng", CC: "--p-cc",
    };
    const ORDER = ["Podemos", "Sumar", "PSOE", "ERC", "Junts", "EH Bildu", "PNV", "BNG", "CC", "UPN", "PP", "Vox", "SALF"];
    const COMBOS = [
      ["PP", "Vox"],
      ["PP", "Vox", "UPN", "CC"],
      ["PSOE", "Sumar", "Podemos"],
      ["PSOE", "Sumar", "Podemos", "ERC", "Junts", "EH Bildu", "PNV", "BNG", "CC"],
      ["PP", "PSOE"],
    ];

    const update = () => {
      const input = Object.fromEntries(inputs.map((i) => [i.name, +i.value]));
      inputs.forEach((i) => {
        i.nextElementSibling!.textContent = `${fmt.format(+i.value)} %`;
        i.style.setProperty("--v", `${(+i.value / +i.max) * 100}%`);
      });
      const { total } = simulate(input, data);
      const parties = ORDER.filter((p) => total[p]);

      const bar = root.querySelector<HTMLElement>("[data-bar]")!;
      bar.innerHTML = parties.map((p) =>
        `<span style="flex:${total[p]};background:${css(VAR[p] ?? "--p-other")}" title="${p}: ${total[p]}"></span>`).join("");

      const sorted = [...parties].sort((a, b) => total[b] - total[a]);
      root.querySelector("[data-table]")!.innerHTML = sorted.map((p) => {
        const d = total[p] - (base2023[p] ?? 0);
        return `<tr><th scope="row"><i style="background:${css(VAR[p] ?? "--p-other")}"></i>${p}</th><td>${total[p]}</td><td>${d > 0 ? "+" : ""}${d === 0 ? "=" : d}</td></tr>`;
      }).join("");

      root.querySelector("[data-combos]")!.innerHTML = COMBOS.map((c) => {
        const n = c.reduce((a, p) => a + (total[p] ?? 0), 0);
        const ok = n >= 176;
        return `<li class="${ok ? "ok" : ""}"><span>${c.join(" + ")}</span><strong>${n}</strong><em>${ok ? "mayoría absoluta" : `faltan ${176 - n}`}</em></li>`;
      }).join("");
    };

    inputs.forEach((i) => i.addEventListener("input", update));
    root.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.addEventListener("click", () => {
      const preset = b.dataset.preset === "2023" ? { ...data.national_2023, Podemos: 0, SALF: 0 } : data.defaults;
      inputs.forEach((i) => (i.value = String(preset[i.name] ?? 0)));
      update();
    }));
    // Veda electoral: sin referencias a las encuestas; se parte del resultado de 2023
    if (inVeda({ from: "2026-11-24", to: "2026-11-29T21:00:00+01:00" })) {
      root.querySelectorAll<HTMLElement>("[data-poll-ref]").forEach((el) => (el.hidden = true));
      root.querySelector<HTMLButtonElement>('[data-preset="2023"]')!.click();
    }
    update();
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", update);
  }
</script>

<style>
  .sim { margin-top: 3rem; padding-top: 2.5rem; border-top: 1px solid var(--rule-strong); }
  .code { margin: 0; font-weight: 700; font-size: 0.95rem; color: var(--brand-ink); }
  h3 { font-size: clamp(1.75rem, 3.2vw, 2.4rem); margin-top: 0.5rem; }
  .sub { margin: 0.5rem 0 0; color: var(--ink-2); max-width: 46rem; font-size: 1rem; }
  .sim-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 2.5rem; margin-top: 1.75rem; align-items: start; }
  .row { display: grid; grid-template-columns: 6rem 1fr 4.2rem; gap: 0.75rem; align-items: center; padding-block: 0.35rem; }
  .name { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; }
  .name i, .seats i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; background: var(--c); }
  /* Deslizador propio: el carril se rellena con el color del partido hasta el valor (--v) */
  input[type="range"] { width: 100%; height: 22px; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: pointer; }
  input[type="range"]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: linear-gradient(to right, var(--c) var(--v, 0%), var(--rule) var(--v, 0%)); }
  input[type="range"]::-moz-range-track { height: 6px; border-radius: 3px; background: linear-gradient(to right, var(--c) var(--v, 0%), var(--rule) var(--v, 0%)); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; margin-top: -6px; border-radius: 50%; background: var(--c); border: 2px solid var(--paper); box-shadow: 0 0 0 1px var(--rule-strong); }
  input[type="range"]::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--c); border: 2px solid var(--paper); box-shadow: 0 0 0 1px var(--rule-strong); }
  input[type="range"]:focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; }
  .pct { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
  .fixed { font-size: 0.88rem; color: var(--ink-3); margin: 0.75rem 0; }
  .buttons { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .buttons button { font: inherit; font-size: 0.92rem; font-weight: 600; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--rule-strong); background: transparent; color: var(--ink); cursor: pointer; }
  .buttons button:hover { background: var(--wash); }

  .bar-wrap { position: relative; padding-top: 1.4rem; }
  .bar { display: flex; gap: 2px; height: 2.2rem; border-radius: 4px; overflow: hidden; background: var(--wash); }
  .bar :global(span) { display: block; min-width: 1px; }
  .majority { position: absolute; top: 0; bottom: -0.3rem; left: calc(176 / 350 * 100%); border-left: 2px solid var(--ink); }
  .majority span { position: absolute; top: 0; left: 0.3rem; font-size: 0.8rem; font-weight: 700; line-height: 1; }
  .seats { width: 100%; border-collapse: collapse; margin-top: 1.25rem; font-size: 0.95rem; }
  .seats :global(th), .seats :global(td) { padding: 0.35rem 0.5rem 0.35rem 0; border-bottom: 1px solid var(--rule); text-align: right; font-variant-numeric: tabular-nums; }
  .seats :global(th:first-child) { text-align: left; }
  .seats thead th { font-weight: 600; color: var(--ink-3); font-size: 0.85rem; }
  .seats :global(tbody th) { font-weight: 600; }
  .seats :global(tbody i) { width: 10px; height: 10px; border-radius: 2px; display: inline-block; margin-right: 0.5rem; }
  h4 { font-family: var(--font-sans); font-size: 1rem; margin: 1.75rem 0 0.2rem; }
  .combos-note { font-size: 0.85rem; color: var(--ink-3); margin: 0 0 0.5rem; }
  .combos { list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }
  .combos :global(li) { display: grid; grid-template-columns: 1fr auto 8.5rem; gap: 0.75rem; padding-block: 0.35rem; border-bottom: 1px solid var(--rule); }
  .combos :global(strong) { font-variant-numeric: tabular-nums; }
  .combos :global(em) { font-style: normal; color: var(--ink-3); text-align: right; }
  .combos :global(li.ok em) { color: var(--ink); font-weight: 600; }
  .sim-foot { margin-top: 1.75rem; color: var(--ink-3); font-size: 0.88rem; max-width: 52rem; }
  .sim-foot p { margin: 0 0 0.5rem; }

  @media (max-width: 860px) {
    .sim-grid { grid-template-columns: 1fr; }
    .combos :global(li) { grid-template-columns: 1fr auto; }
    .combos :global(em) { grid-column: 1 / -1; text-align: left; }
  }
</style>
